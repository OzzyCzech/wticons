{
	"name": "wticons",
	"private": true,
	"description": "Bundle of website development and technology icons for React and Astro",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OzzyCzech/wticons.git"
	},
	"author": "Roman Ožana <roman@ozana.cz>",
	"license": "MIT",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"optimize": "svgo -i ./icons",
		"build": "pnpm optimize && pnpm -r run rebuild && node ./update.js"
	},
	"pnpm": {
		"overrides": {
			"@svgr/plugin-svgo>svgo": "3.3.5",
			"ip-address": "^10.7.4",
			"cosmiconfig>js-yaml": "^4.3.2",
			"nx>undici": "^7.29.1",
			"postcss-selector-parser": "^7.1.6"
		}
	},
	"devDependencies": {
		"lerna": "^10.1.1",
		"svgo": "^4.1.0"
	},
	"keywords": [
		"programming",
		"development",
		"webdesign",
		"technology",
		"icons",
		"react",
		"astro",
		"svg"
	],
	"dependencies": {
		"@babel/runtime": "^8.0.7"
	}
}
