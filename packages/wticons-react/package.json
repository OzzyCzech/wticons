{
	"name": "@wticons/react",
	"version": "3.0.0",
	"description": "Bundle of website development and technology icons",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OzzyCzech/wticons.git",
		"directory": "packages/wticons-react"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "Roman Ožana <roman@ozana.cz>",
	"license": "MIT",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
