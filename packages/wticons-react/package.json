	},
	"keywords": [
		"programming",
		"development",
		"webdesign",
		"technology",
		"icons",
		"icon pack",
		"react",
		"vector",
		"vectors",
		"svg",
		"svgs",
		"ui",
		"ux"
	],
	"peerDependencies": {
		"react": "*"
	},
	"dependencies": {
		"@babel/runtime": "^8.0.7"
	}
