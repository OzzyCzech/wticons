{
	"name": "@wticons/react",
	"version": "3.0.1",
	"description": "Bundle of website development and technology icons",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OzzyCzech/wticons.git",
		"directory": "packages/wticons-react"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "Roman Ožana <roman@ozana.cz>",
	"license": "MIT",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "rimraf ./src ./types ./dist",
		"svgr": "svgr --typescript --index-template ./index-template.cjs --out-dir src -- ../../icons",
		"tsc": "tsc",
		"build": "pnpm svgr && pnpm tsc",
		"rebuild": "pnpm clean && pnpm build"
	},
	"devDependencies": {
		"@ozzyczech/tsconfig": "^2.1.0",
		"@svgr/cli": "^8.1.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"rimraf": "^6.1.3",
		"typescript": "^7.0.2"
	},
	"keywords": [
		"programming",
		"development",
		"webdesign",
		"technology",
		"icons",
		"icon pack",
		"react",
		"vector",
		"vectors",
		"svg",
		"svgs",
		"ui",
		"ux"
	],
	"peerDependencies": {
		"react": "*"
	}
}
